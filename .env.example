# ---- OpenAI ----
# Platform API key with Realtime access and billing enabled.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Realtime model. gpt-realtime-2.1-mini is ~3x cheaper and plenty good for this.
# Swap to gpt-realtime-2.1 if you want the highest-quality voice.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini

# Transcription of the agent's side. whisper-1 is the safe default; if agent turns
# come back empty, try gpt-4o-mini-transcribe and re-run `python analyze.py repair`.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Set to 1 to print every Realtime server event. Useful while tuning.
REALTIME_DEBUG=0

# ---- Twilio ----
# From https://console.twilio.com  (Account SID starts with AC)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The ONE number used for every test call, E.164. This is what you report on the form.
TWILIO_FROM_NUMBER=+15551234567

# ---- Target ----
# Pretty Good AI assessment line. Do not change.
TARGET_NUMBER=+18054398008

# ---- Tunnel ----
# Public host that Twilio will open the media-stream websocket against.
# Host only, no scheme and no trailing slash. Example: fluffy-badger-42.ngrok-free.app
PUBLIC_HOST=your-subdomain.ngrok-free.app

# ---- Local server ----
PORT=5050
