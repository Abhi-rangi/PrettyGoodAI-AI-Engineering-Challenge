# ---- OpenAI ----
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
VOICE=marin
# Print every Realtime server event. Useful while tuning.
REALTIME_DEBUG=0

# ---- Twilio ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The clinic number patients call, E.164. preflight.py checks its webhook points here.
TWILIO_NUMBER=+15551234567
# Rejects /voice requests Twilio did not sign. Only turn off for local experiments.
VALIDATE_TWILIO_SIGNATURE=1

# ---- Public host ----
# Host only, no scheme. The clinic number's voice webhook must be https://<host>/voice
PUBLIC_HOST=your-subdomain.ngrok-free.app

# ---- Clinic ----
CLINIC_NAME=RD Physical Therapy & Wellness
CLINIC_TIMEZONE=America/New_York

# ---- Call behaviour ----
MAX_CALL_S=600
# Silence that ends the caller's turn. Higher tolerates pauses while spelling.
VAD_SILENCE_MS=1100
VAD_THRESHOLD=0.55

# ---- PHI ----
# Call audio and transcripts contain patient information. Off by default.
STORE_CALLS=0
LOG_TRANSCRIPTS=0
CALL_DIR=./var/calls
